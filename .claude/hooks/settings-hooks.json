{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs input or permission\" with title \"Claude Code: Notification\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pstack-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/handoff.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); active=$(echo \"$input\" | jq -r '.stop_hook_active // false' 2>/dev/null); [ \"$active\" = \"true\" ] || osascript -e 'display notification \"Claude has finished\" with title \"Claude Code: Stop\"'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/handoff.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
